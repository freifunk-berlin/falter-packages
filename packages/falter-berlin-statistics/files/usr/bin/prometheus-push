#!/bin/sh

. /lib/functions.sh

INTERVAL=60 # How often to push metrics (in seconds)
TMP_FILE="/tmp/metrics.txt"

while true; do
    ENABLED=""
    HOSTNAME=""
    PUSHHOST=""
    PUSHPORT=""
    PUSHPATH=""
    config_load prometheus-push
    config_get ENABLED statistics enabled "0"

    if [ "$ENABLED" = "0"]; then
        HOSTNAME=$(uci_get system @system[0] hostname)

        config_get INTERVAL statistics interval 60
        config_get PUSHHOST server host
        config_get PUSHPORT server port
        config_get PUSHPATH server path
        URL="http://${PUSHHOST}:${PUSHPORT}${PUSHPATH}${HOSTNAME}"

        # execute the ucode node exporter and save to /tmp
        prometheus-node-exporter-ucode | tail -n +4 > "$TMP_FILE"

        # upload to pushgateway
        wget -q -O - \
            --header="Content-Type: application/x-www-form-urlencoded" \
            --post-file="$TMP_FILE" \
            "$URL"

        # start background process to gather ping stats
        /usr/bin/pingbot &
    fi

    sleep "$INTERVAL"
done

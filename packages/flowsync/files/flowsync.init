#!/bin/sh /etc/rc.common

# shellcheck disable=SC2034
# shellcheck disable=SC3043

USE_PROCD=1
START=90
STOP=10
EXTRA_COMMANDS="check announce"
EXTRA_HELP="	check	Print the configuration as the daemon parses it
	announce <client> <cport> <server> <sport> [proto]	Send one record to all peers"

PROG=/usr/sbin/flowsync

# render UCI into command line options; $1 is the function that takes
# each option (procd_append_param command, or append_arg for the commands)
_opt() {
	local val
	config_get val main "$2"
	[ -n "$val" ] && "$1" "--$3" "$val"
}

# a list option; config_get also returns one written as a plain option (which
# config_list_foreach would skip silently), list values joined by spaces. None
# of the values (addresses, prefixes, ports, protocol names) contains a space.
_list() {
	local vals v
	config_get vals main "$2"
	for v in $vals; do
		"$1" "--$3" "$v"
	done
}

render_options() {
	local add="$1"
	local debug

	config_load flowsync
	config_get_bool debug main debug 0
	[ "$debug" = 1 ] && "$add" --debug
	_opt "$add" bind_address bind
	_opt "$add" interface interface
	_opt "$add" port port
	_opt "$add" interval interval
	_opt "$add" element_timeout element-timeout
	_opt "$add" batch_lines batch-lines
	_opt "$add" tx_rate tx-rate
	_opt "$add" rcvbuf rcvbuf
	_opt "$add" ct_mark ct-mark
	_opt "$add" ct_mark_mask ct-mark-mask
	_opt "$add" max_copies max-copies
	_opt "$add" max_copies_per_client max-copies-per-client
	_list "$add" proto proto
	_list "$add" skip_server_port skip-server-port
	_list "$add" peer peer
	_list "$add" prefix prefix
	_list "$add" exclude exclude
	_list "$add" exclude_dst exclude-dst
}

start_service() {
	local enabled

	config_load flowsync
	config_get_bool enabled main enabled 0
	[ "$enabled" = 1 ] || return 0

	procd_open_instance
	procd_set_param command "$PROG"
	render_options procd_append_param_command
	procd_append_param command run
	# the daemon takes its config from the command line: restart on change
	procd_set_param file /etc/config/flowsync
	procd_set_param respawn 3600 5 0
	procd_set_param stderr 1
	procd_close_instance
}

procd_append_param_command() {
	procd_append_param command "$@"
}

service_triggers() {
	procd_add_reload_trigger flowsync
}

status_service() {
	_procd_status flowsync
	"$PROG" status
}

# collect options into $ARGS, quoted for eval
ARGS=""
append_arg() {
	local a
	for a in "$@"; do
		ARGS="$ARGS '$(printf '%s' "$a" | sed "s/'/'\\\\''/g")'"
	done
}

check() {
	render_options append_arg
	eval "$PROG" "$ARGS" check
}

announce() {
	local opts

	render_options append_arg
	opts="$ARGS"
	# the flow is quoted like the options, so eval sees it as plain words
	ARGS=""
	append_arg "$@"
	eval "$PROG" "$opts" announce "$ARGS"
}

# Rendered by bbb-configs. See /usr/share/doc or the package README.
config flowsync 'main'
	option enabled '0'
	option debug '0'
	option bind_address ''
	# the uplink (logical interface or device): sync datagrams from any other
	# interface are ignored
	option interface ''
	option port '3780'
	option interval '30'
	option element_timeout '90'
	option batch_lines '30'
	option tx_rate '500'
	# 0: 4 x tx_rate
	option resync_rate '0'
	option rcvbuf '8388608'
	option ct_mark '0x01000000'
	option ct_mark_mask '0x01000000'
	option max_copies '0'
	# 0: no limit per client; count a Freifunk location with prefix length 56
	option max_copies_per_client '0'
	option client_prefix_len '64'
	list proto 'udp'
	list proto 'tcp'
	list skip_server_port '53'
	# list peer '<other gateway uplink address>'
	# list prefix '2001:bf7:750::/44'
	# list exclude_dst '2001:bf7::/32'
	# list exclude '<prefix filtered elsewhere>'

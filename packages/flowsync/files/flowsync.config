# Rendered by bbb-configs. See the package README.
config flowsync 'main'
	option enabled '0'
	option debug '0'
	# this gateway's uplink address as the peers list it, IPv4 or IPv6, the
	# same family as the peers
	option bind_address ''
	# the uplink (logical interface or device): sync datagrams from any other
	# interface are ignored
	option interface ''
	# where forwarded traffic leaves to the Internet, if that is not the
	# interface above: the tc programs attach there
	# option uplink ''
	# forward accepted TCP and UDP packets straight from the uplink's tc hook,
	# past netfilter and the kernel's forwarding path (see README, "Bypass")
	option bypass '0'
	option port '3994'
	option interval '30'
	option element_timeout '90'
	option batch_lines '30'
	option tx_rate '500'
	# 0: 4 x tx_rate
	option resync_rate '0'
	option rcvbuf '8388608'
	# forwarded IPv6 stays out of conntrack this long after the daemon last saw
	# its programs on the uplink; then conntrack tracks it until they are back
	option alive_timeout '10'
	# packet mark of accepted packets; the same value must be in
	# /usr/share/nftables.d/chain-pre/forward/10-flowsync.nft
	option mark '0x01000000'
	# the firewall's inet table; the accept rule goes into its forward chain
	option fw_table 'fw4'
	# sizes of the two flow tables: own flows, and the other gateways'
	option max_flows '131072'
	option max_remote '131072'
	# how long a flow lives after its last packet out, seconds
	option udp_timeout '180'
	option tcp_timeout '7440'
	option tcp_syn_timeout '120'
	option tcp_close_timeout '120'
	option other_timeout '600'
	# synced protocols (this is the default list): names as here, sctp, or
	# a protocol number
	list proto 'udp'
	list proto 'tcp'
	list proto 'esp'
	list proto 'gre'
	list proto 'ipip'
	list proto 'ip6ip6'
	list proto 'l2tp'
	list skip_server_port '53'
	# authenticates the sync datagrams: 32 hexadecimal digits (openssl rand
	# -hex 16), the same on all gateways. Optional but recommended: without
	# it, whoever can send with a peer's address is believed. Several keys:
	# the first signs, all are accepted (to change the key without a gap).
	# Or keep them out of this file: key_file names a file that holds them.
	# list key '<32 hexadecimal digits>'
	# option key_file '/etc/flowsync.key'
	# list peer '<other gateway uplink address, IPv4 or IPv6, all of one family>'
	# list prefix '2001:bf7:750::/44'
	# list exclude_dst '2001:bf7::/32'
	# list exclude '<prefix filtered elsewhere>'

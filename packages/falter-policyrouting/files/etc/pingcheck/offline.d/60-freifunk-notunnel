#!/bin/sh

# shellcheck disable=SC2154

[ "$INTERFACE" = wan ] || exit

. /lib/functions.sh

config_load ffwizard
config_get ffuplink setting ffuplink

[ "$ffuplink" = notunnel ] || exit

# Internet connectivity via WAN is down, stop the ffuplink interface
logger -t freifunk-pingcheck "WAN is down, stopping ffuplink"
ifdown ffuplink

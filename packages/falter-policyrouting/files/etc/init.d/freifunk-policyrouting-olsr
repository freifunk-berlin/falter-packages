#!/bin/sh /etc/rc.common

USE_PROCD=1
START=15
PROCD_RELOAD_DELAY=500

CMD=/usr/sbin/freifunk-policyrouting-olsr

start_service() {
    procd_open_instance
    procd_set_param command "$CMD" start
    procd_set_param stdout 1
    procd_set_param stderr 1
    prod_close_instance
}

stop_service() {
    logger -t "freifunk-policyrouting-olsr stopped"

    "$CMD" stop
}

reload_service() {
    logger -t "freifunk-policyrouting-olsr reloading"

    "$CMD" start
}

service_triggers() {
    procd_add_reload_trigger "olsrd" "network" "firewall"
}
